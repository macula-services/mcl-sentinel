%% -*- mode: erlang -*-
%% rebar3 configuration for mcl_sentinel.
%%
%% Correlates warden sightings into cross-border campaigns and publishes them, enriched, to the threat commons
%%
%% Generated by `rebar3 new mcl_service'. The scaffold boots, joins the mesh
%% and answers /health; it does nothing else yet.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% The shared L2 substrate: mesh SDK, realm identity, capabilities, health.
    %% Brings macula (QUIC NIF) transitively. The service module exports no
    %% store_id/0 + data_dir/0, so mcl_om wires the mesh and starts NO
    %% reckon-db. Export both callbacks to turn this into a CMD/PRJ service that
    %% owns an event store; mcl_om:boot/1 does the wiring before start/1.
    %% 0.26.2 floor: it refuses to start on an identity key it cannot save,
    %% where 0.26.1 ran on a throwaway identity nobody could list.
    {mcl_om, "~> 0.26.2"},
    %% MaxMind-DB-format reader (pure Erlang), for the DB-IP Lite geolocation
    %% and ASN databases that enrich each attacker.
    {locus, "~> 2.3"},
    %% 1.24 marks a restart's replayed events. The sentinel has no evoq event
    %% handler today (replay_policy_tests guards any that is added); the floor
    %% keeps it on the release that can tell replay from new.
    {evoq, "~> 1.24"}
]}.

{project_plugins, [rebar3_lint]}.

%% The org's structural ruleset, matching the sibling services.
{elvis, [
    {rulesets, #{
        mcl_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [
        #{files => ["apps/*/src/**/*.erl"], ruleset => mcl_min}
    ]}
]}.

{eunit_opts, [verbose]}.

{relx, [
    {release, {mcl_sentinel, "0.1.0"}, [mcl_sentinel, sasl]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src,    "config/vm.args.src"},
    {extended_start_script, true}
]}.

{profiles, [
    %% meck stands in for the store and the mesh in the ingest tests, so each
    %% case sees exactly what the handler hands on.
    {test, [{deps, [{meck, "~> 1.2"}]}]},
    {prod, [{relx, [{mode, prod},
                    {include_src, false},
                    {include_erts, true},
                    {debug_info, strip}]}]}
]}.
