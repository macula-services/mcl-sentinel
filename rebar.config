%% -*- mode: erlang -*-
%% rebar3 configuration for mcl_sentinel.
%%
%% Correlates warden sightings into cross-border campaigns and publishes them, enriched, to the threat commons
%%
%% Generated by `rebar3 new mcl_service'. The scaffold boots, joins the mesh
%% and answers /health; it does nothing else yet.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% The shared L2 substrate: mesh SDK, realm identity, capabilities, health.
    %% It opens no store from 0.35 on (mcl-om#10), so this service declares and
    %% opens its own (mcl_sentinel_store). 0.39 serves /health on a Unix socket (health_socket) and
    %% builds on macula 14; 14.2 is the SDK base every deployed service runs on. Floats within 0.x on released versions (dev rule).
    {mcl_om, "~> 0.39"},
    %% MaxMind-DB-format reader (pure Erlang), for the DB-IP Lite geolocation
    %% and ASN databases that enrich each attacker.
    {locus, "~> 2.3"},
    %% This service's own event store. Floors: evoq 1.26.1 measures telemetry
    %% durations on the monotonic clock (1.24 already marks a restart's replayed
    %% events; the sentinel has no evoq event handler today, and
    %% replay_policy_tests guards any that is added); reckon_evoq 2.7.2 reads
    %% snapshots back whole.
    {reckon_db,   "~> 5.4"},
    {evoq,        ">= 1.26.1 and < 2.0.0"},
    {reckon_evoq, ">= 2.7.2 and < 3.0.0"}
]}.

{project_plugins, [rebar3_lint]}.

%% The org's structural ruleset, matching the sibling services.
{elvis, [
    {rulesets, #{
        mcl_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [
        #{files => ["apps/*/src/**/*.erl"], ruleset => mcl_min}
    ]}
]}.

{eunit_opts, [verbose]}.

%% The facts module and the warden-report subscriber call `macula', and the
%% campaign desks implement evoq's behaviours and read its event store, but
%% neither is in the PLT unless it is named here: dialyzer would report every
%% call unknown and every behaviour's callbacks unavailable.
{dialyzer, [{plt_extra_apps, [macula, evoq]}]}.

{relx, [
    {release, {mcl_sentinel, "0.1.0"}, [mcl_sentinel, sasl]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src,    "config/vm.args.src"},
    {extended_start_script, true}
]}.

{profiles, [
    %% meck stands in for the store and the mesh in the ingest tests, so each
    %% case sees exactly what the handler hands on.
    {test, [{deps, [{meck, "~> 1.2"}]}]},
    {prod, [{relx, [{mode, prod},
                    {include_src, false},
                    {include_erts, true},
                    {debug_info, strip}]}]}
]}.
