{application, mcl_sentinel, [
    {description, "Correlates warden sightings into cross-border campaigns and publishes them, enriched, to the threat commons"},
    {vsn, "0.1.0"},
    {registered, [mcl_sentinel_sup]},
    {mod, {mcl_sentinel_app, []}},
    {applications, [
        kernel,
        stdlib,
        crypto,
        %% Mesh SDK, realm identity, capabilities, health.
        mcl_om
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/macula-services/mcl-sentinel"}]}
]}.
